# --- Database ---
# Connection string to your Postgres database (Neon, Supabase, Railway, RDS, or self-hosted).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth ---
# Random long secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-secret"

# --- Email (password reset and backup attachments) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
# Với Gmail và tài khoản có 2FA, dùng Google App Password; không dùng mật khẩu Gmail thông thường.
SMTP_PASS="your-google-app-password"
SMTP_FROM="you@gmail.com"

# Secret ngẫu nhiên để Vercel Cron gửi Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-a-long-random-secret"

# --- Vercel Private Blob for automatic backups ---
# Create and connect a PRIVATE Blob store to this project. Vercel normally injects
# BLOB_READ_WRITE_TOKEN automatically. With OIDC, VERCEL_OIDC_TOKEN and BLOB_STORE_ID
# can be used by the official SDK instead. Never expose these variables to the browser.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
BACKUP_RETENTION_DAYS="14"
# Provider maximum is 7 days.
BACKUP_EMAIL_LINK_TTL_DAYS="7"

# --- Optional: AI-generated IPA phonetic transcriptions ---
# Single key:
# GEMINI_API_KEY="AIzaSy..."
# Or multiple keys (comma-separated) to auto-rotate when one hits its free-tier rate limit:
# GEMINI_API_KEYS="AIzaSy_key_1,AIzaSy_key_2"

NODE_ENV="production"

# --- Google Sheets Sync (Lexora quản lý Google Sheet tự động) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# Exact redirect URI registered in Google Cloud Console (must match scheme/host/port).
GOOGLE_REDIRECT_URI="https://your-domain.com/api/admin/google-sheets/oauth/callback"
# Public base URL of this deployment; Drive push notifications POST to
# {GOOGLE_WEBHOOK_BASE_URL}/api/webhooks/google-drive (must be HTTPS in production).
GOOGLE_WEBHOOK_BASE_URL="https://your-domain.com"
# HMAC secret used to sign the channel token Google sends as
# x-goog-channel-token; generate with: openssl rand -hex 32
GOOGLE_WEBHOOK_TOKEN_SECRET="replace-with-a-long-random-hex"
# AES-256-GCM key used to encrypt OAuth access/refresh tokens at rest.
# Generate with: openssl rand -hex 32
GOOGLE_SHEET_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-hex"
